# OpenAI integration

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_COMPLEX_MODEL=gpt-4o

# Optional fallback and tuning
# FALLBACK_MODEL=gpt-4o-mini
# AI_FALLBACK_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=500

# Optional OpenAI endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE=https://api.openai.com/v1

# GPT-OSS separation. Local WSL/external GPU handles GPT-OSS; Railway remains
# web/worker/control plane. Do not point Railway OPENAI_BASE_URL at local
# 127.0.0.1/localhost. Use GPTOSS_API_BASE_URL for cloud GPT-OSS.
# GPTOSS_LOCAL_ENABLED=false
# GPTOSS_LOCAL_API_BASE_URL=http://127.0.0.1:11434/v1
# GPTOSS_LOCAL_MODEL=gpt-oss
# GPTOSS_LOCAL_HEALTH_TIMEOUT_MS=5000
# GPTOSS_API_BASE_URL=https://your-gptoss-gateway.example/v1
# OPENAI_REFERENCE_MODEL=ft:gpt-4.1-2025-04-14:personal:arcanos:DIbLRZm2
# ARCANOS_REFERENCE_MODEL_ROLE=evaluate_only
# GPTOSS_MODEL=openai/gpt-oss-20b
# ARCANOS_MODEL_PROVIDER=hybrid_trinity
# ARCANOS_CAPTURE_OPENAI_OUTPUT=false
# ARCANOS_USE_OPENAI_OUTPUT_FOR_TRAINING=false
# ARCANOS_REFERENCE_OUTPUT_TTL_SECONDS=0

# Retry/cache defaults
OPENAI_MAX_RETRIES=2
OPENAI_CACHE_TTL_MS=300000

# Dedicated overrides
# FINETUNED_MODEL_ID=
# AI_MODEL=
# RESEARCH_MODEL_ID=
TRINITY_REASONING_MODEL=gpt-5.6-terra
# Shared GPT-5 override and explicit GPT-5.1 rollback, in that order.
# GPT5_MODEL=
# GPT51_MODEL=gpt-5.1
# Includes hidden reasoning and visible structured output. Strict positive base-10 integers are
# clamped to 16-8000; invalid or unset values use 8000.
# TRINITY_REASONING_MAX_OUTPUT_TOKENS=8000
# Also clamped to the remaining request/runtime budget.
# TRINITY_REASONING_STAGE_TIMEOUT_MS=20000
# Positive overrides are honored up to Backstage Booker's 2400-token cap; full-show/card
# review-only prompts use at most 1600 and compact direct-answer prompts may lower them further.
# BOOKER_TOKEN_LIMIT=2400
# Backstage-only provider stage budget; positive values are capped at 45000ms.
# BOOKER_GENERATION_STAGE_TIMEOUT_MS=40000

IMAGE_MODEL=gpt-image-1
IMAGE_DEFAULT_SIZE=1024x1024
