# Railway deployment variables

RAILWAY_PROJECT=arcanos-core
RAILWAY_ENVIRONMENT=production

# Optional project/service metadata
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_DEPLOYMENT_ID=
# RAILWAY_RELEASE_ID=

# Railway management API
# RAILWAY_API_TOKEN=
# RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.app/graphql/v2
# RAILWAY_GRAPHQL_TIMEOUT_MS=15000

# OpenAI and GPT access
# OPENAI_API_KEY=
# OPENAI_API_KEY_REQUIRED=true
# OPENAI_BASE_URL=https://api.openai.com/v1
# Railway stays web/worker/control plane. Do not set OPENAI_BASE_URL to local
# 127.0.0.1/localhost for GPT-OSS; use GPTOSS_API_BASE_URL for cloud GPT-OSS.
# Do not set GPTOSS_LOCAL_* values in Railway variables.
# GPTOSS_API_BASE_URL=https://your-gptoss-gateway.example/v1
# ARCANOS_CAPTURE_OPENAI_OUTPUT=false
# ARCANOS_USE_OPENAI_OUTPUT_FOR_TRAINING=false
# OPENAI_ACTION_SHARED_SECRET=
# ARCANOS_GPT_ACCESS_TOKEN=
# Optional web-service-only credential for protected Backstage Booker reads,
# canon writes, and authenticated Notion-enriched generation provenance.
# Do not configure this on the worker service.
# ARCANOS_BACKSTAGE_BOOKER_ACCESS_TOKEN=
# Optional rollout flag; only exact true enables queueing. Enable only after the same distinct current key is
# configured on web and worker. For rotation, stage both roles K1/K2, then
# worker K2/K1, then web K2/K1; remove K1 only after retained jobs drain.
# ARCANOS_BACKSTAGE_BOOKER_ASYNC_GENERATION_ENABLED=false
# ARCANOS_BACKSTAGE_BOOKER_JOB_PAYLOAD_KEY=
# ARCANOS_BACKSTAGE_BOOKER_JOB_PAYLOAD_PREVIOUS_KEY=
# Optional read-only Notion generation supplement. Configure both on the web
# service only. Use one to three raw page UUIDs per exact universe ID; never put
# the Notion token in Builder or reuse an ARCANOS application credential.
# ARCANOS_BACKSTAGE_NOTION_ACCESS_TOKEN=
# ARCANOS_BACKSTAGE_NOTION_UNIVERSE_PAGES_JSON={"my-universe-2k26":["11111111-1111-4111-8111-111111111111"]}
# Optional web-service-only credential for the Arcanos Gaming source lifecycle
# Actions. Do not configure this on the worker service.
# ARCANOS_GAMING_SOURCE_ACCESS_TOKEN=
# ARCANOS_GPT_ACCESS_BASE_URL=https://your-service.up.railway.app
# ARCANOS_GPT_ACCESS_SCOPES=runtime.read,workers.read,queue.read,jobs.create,jobs.result,logs.read_sanitized,db.explain_approved,mcp.approved_readonly,diagnostics.read
# Optional GPT Access natural-language dispatcher for the web gateway service only.
# When unset, a real resolved OpenAI key makes the gateway use hybrid; missing/mock/placeholder keys use rules.
# Resolved keys follow OPENAI_API_KEY, RAILWAY_OPENAI_API_KEY, API_KEY, then OPENAI_KEY.
# Invalid mode values resolve to rules. Set rules to force deterministic/no-LLM dispatch.
# Timeout/failure never executes an LLM plan.
# GPT_ACCESS_NL_DISPATCH_MODE=
# GPT_ACCESS_DISPATCH_MODEL=gpt-4.1-mini
# GPT_ACCESS_DISPATCH_LLM_TIMEOUT_MS=5000  # capped at 10000
# Add capabilities.read/capabilities.run only when direct capability discovery/execution is required.
# Required only when capabilities.run or MCP modules.invoke should execute allowed actions.
# MCP_ALLOW_MODULE_ACTIONS=ARCANOS:CORE:query
# RAILWAY_OPENAI_API_KEY=
# RAILWAY_OPENAI_MODEL=
# RAILWAY_OPENAI_FALLBACK_MODEL=

# Service role and worker behavior
# ARCANOS_PROCESS_KIND=web
# RUN_WORKERS=false
# WORKER_API_TIMEOUT_MS=60000
# JOB_WORKER_CONCURRENCY=2
# JOB_WORKER_HEARTBEAT_MS=5000
# Claimed-job lease duration; runtime clamps this to 3000-300000ms and renews it during execution and terminal persistence.
# JOB_WORKER_LEASE_MS=30000
# JOB_WORKER_STALE_AFTER_MS=45000
# JOB_WORKER_WATCHDOG_MS=10000
# JOB_WORKER_WATCHDOG_IDLE_MS=120000
# JOB_WORKER_MAX_RETRIES=2
# JOB_WORKER_RETRY_BASE_MS=2000
# JOB_WORKER_RETRY_MAX_MS=60000
# Protected Backstage worker execution has one finite job deadline with reserved recovery and
# result-persistence headroom. Values outside the documented bounds are clamped.
# BOOKER_WORKER_JOB_TIMEOUT_MS=180000
# BOOKER_WORKER_GENERATION_STAGE_TIMEOUT_MS=80000
# BOOKER_REPAIR_STAGE_TIMEOUT_MS=45000
# Lightweight continuity stays synchronous and uses a lower bounded stage timeout.
# BOOKER_CONTINUITY_STAGE_TIMEOUT_MS=20000
# QUEUE_FAILED_JOB_CLEANUP_ENABLED=true
# QUEUE_FAILED_JOB_RETENTION_COUNT=50
# QUEUE_FAILED_JOB_CLEANUP_MIN_AGE_MS=86400000
# JOB_EVENT_CLEANUP_ENABLED=true
# JOB_EVENT_RETENTION_DAYS=30
# JOB_EVENT_CLEANUP_BATCH_SIZE=1000
# JOB_EVENT_CLEANUP_DRY_RUN=true
# JOB_EVENT_RECORD_HEARTBEATS=false

# Public endpoint hints
# API_URL=https://your-service.up.railway.app
# BACKEND_REGISTRY_URL=https://your-service.up.railway.app/registry
