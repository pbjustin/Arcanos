# Integrations and automation

# Assistant registry. Automatic startup/cron provider sync is retired; use the
# challenge-confirmed one-shot backend client when an operator approves it.
# ASSISTANT_REGISTRY_PATH=./config/assistants.json
# ASSISTANTS_BACKEND_URL=http://127.0.0.1:3000
# ASSISTANTS_SYNC_TIMEOUT_MS=10000
# ASSISTANTS_SYNC_CONFIRMATION_CHALLENGE=

# GitHub integration
# GITHUB_TOKEN=your-github-token-here
# GITHUB_WEBHOOK_SECRET=replace-me
ENABLE_GITHUB_ACTIONS=true

# Optional app-level integration values
# APP_ID=
# WEBHOOK_SECRET=
# PRIVATE_KEY_PATH=./private-key.pem

# Email integration placeholders
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_USER=apikey
# EMAIL_PASS=replace-me
