# Security and access controls

# Admin/registration controls
# ADMIN_KEY=your-admin-key
# REGISTER_KEY=your-register-key

# Optional root override for local development only
ALLOW_ROOT_OVERRIDE=false
# ROOT_OVERRIDE_TOKEN=replace-me

# Automation bypass for confirmation gate
# ARCANOS_AUTOMATION_SECRET=replace-me
# ARCANOS_AUTOMATION_HEADER=x-arcanos-automation

# Ordinary GPT IDs are confirmation metadata, not authentication or approval.
# With global allow-all disabled, permitted one-time approval requires an unexpired
# backend-issued x-arcanos-confirm-token, consumed on successful approval.
# Manual x-confirmed: yes and the configured automation secret remain ordinary
# approvals; challenge-only routes require their issued, request-bound, one-use challenge.
# Route authentication and scopes remain separate requirements.
# TRUSTED_GPT_IDS=gpt-abc,gpt-def
# Compatibility: a standalone * entry in TRUSTED_GPT_IDS or exact ALLOW_ALL_GPTS=true
# enables global allow-all for ordinary requests, even without GPT ID or valid token.
# ALLOW_ALL_GPTS=false does not override *; supplied tokens are not validated/consumed.
# Challenge-only and independent authentication/scope requirements still apply.
# Active production exposure is UNVERIFIED; examples do not establish deployed values.
# ALLOW_ALL_GPTS=false

# Daemon and registry rate limiting
# DAEMON_RATE_LIMIT_MAX=400
# DAEMON_RATE_LIMIT_WINDOW_MS=600000
# DAEMON_REGISTRY_RATE_LIMIT_MAX=120
# DAEMON_REGISTRY_RATE_LIMIT_WINDOW_MS=600000
