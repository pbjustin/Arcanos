{
  "compilerOptions": {
    "baseUrl": "..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@arcanos/runtime/requestAbort": [
        "packages/arcanos-runtime/src/requestAbort.ts"
      ],
      "@arcanos/runtime/redaction": [
        "packages/arcanos-runtime/src/redaction.ts"
      ],
      "@core/lib/*.js": [
        "src/lib/*.ts"
      ],
      "@core/lib/*": [
        "src/lib/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@shared/redaction.js": [
        "packages/arcanos-runtime/src/redaction.ts"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@services/gamingModes.js": [
        "src/services/gamingModes.ts"
      ],
      "@services/publicGamingCanaryFixture.js": [
        "src/services/publicGamingCanaryFixture.ts"
      ],
      "@transport/*": [
        "src/transport/*"
      ]
    }
  }
}
