{
  "openapi": "3.1.0",
  "info": {
    "title": "Arcanos Async Job Result API",
    "version": "1.0.0",
    "description": "Canonical capability-bound read contract for retrieving stored public async GPT or Ask job results without enqueueing new work. GPT jobs must carry recognized public-route or custom-bridge provenance; GPT Access-created jobs remain protected."
  },
  "paths": {
    "/jobs/{jobId}/result": {
      "get": {
        "operationId": "getJobResult",
        "summary": "Retrieve a stored async GPT job result",
        "description": "Returns the stored result lifecycle for a public `gpt` or `ask` job id. GPT jobs require recognized public-route or custom-bridge provenance; GPT Access-created jobs are concealed. This route is read-only, never enqueues work, requires the job-specific capability returned by the creating response, and always uses `Cache-Control: no-store`. Missing jobs, non-public job types or provenance, and missing, malformed, duplicated, incorrect, or cross-job capabilities are reported in-body with `status: \"not_found\"`.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "Async job identifier returned by `POST /gpt/{gptId}`.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/components/parameters/JobReadToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored async job result lookup payload.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResultLookup"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job id",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteError"
                }
              }
            }
          },
          "503": {
            "description": "Job reads are unavailable because neither the current `ARCANOS_JOB_READ_CAPABILITY_SECRET` nor the optional previous verification key is valid, or durable job persistence is unavailable.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReadUnavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "JobReadToken": {
        "name": "x-arcanos-job-read-token",
        "in": "header",
        "required": true,
        "description": "Job-specific bearer capability returned as `jobReadToken` by the creating async response. Send exactly one header whose value is bound to this path job id; query-string, cookie, and body carriers are not accepted.",
        "schema": {
          "type": "string",
          "pattern": "^v1\\.[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "headers": {
      "NoStore": {
        "description": "The response must not be stored by clients or intermediary caches.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    },
    "schemas": {
      "JobReadUnavailable": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "JOB_READ_AUTH_UNAVAILABLE",
              "JOB_REPOSITORY_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "description": "Present for `JOB_READ_AUTH_UNAVAILABLE` and fixed to `Async job reads are temporarily unavailable.`"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "JobResultLookupStatus": {
        "type": "string",
        "enum": [
          "pending",
          "completed",
          "failed",
          "expired",
          "not_found"
        ]
      },
      "RouteError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "details": {}
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "JobResultLookup": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobResultLookupStatus"
          },
          "jobStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycleStatus": {
            "type": "string"
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retentionUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "idempotencyUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "poll": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "result": {},
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "jobId",
          "status",
          "jobStatus",
          "lifecycleStatus",
          "createdAt",
          "updatedAt",
          "completedAt",
          "retentionUntil",
          "idempotencyUntil",
          "expiresAt",
          "poll",
          "stream",
          "result",
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
