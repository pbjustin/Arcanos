{
  "openapi": "3.1.0",
  "info": {
    "title": "Arcanos Async Job Status API",
    "version": "1.0.0",
    "description": "Canonical capability-bound read contract for retrieving public async GPT or Ask job status without enqueueing new work. GPT jobs must carry recognized public-route or custom-bridge provenance; GPT Access-created jobs remain protected."
  },
  "paths": {
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getJobStatus",
        "summary": "Retrieve canonical async GPT job status",
        "description": "Returns the stored async job status payload for a public `gpt` or `ask` job id. GPT jobs require recognized public-route or custom-bridge provenance; GPT Access-created jobs are concealed. This route is read-only, never enqueues work, requires the job-specific capability returned by the creating response, and always uses `Cache-Control: no-store`.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "Async job identifier returned by `POST /gpt/{gptId}`.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/components/parameters/JobReadToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored async job status payload.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job id",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteError"
                }
              }
            }
          },
          "404": {
            "description": "Job not found, job type is not publicly readable, or the job-read capability is missing, malformed, duplicated, incorrect, or bound to another job id.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteError"
                }
              }
            }
          },
          "503": {
            "description": "Job reads are unavailable because neither the current `ARCANOS_JOB_READ_CAPABILITY_SECRET` nor the optional previous verification key is valid, or durable job persistence is unavailable.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReadUnavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "JobReadToken": {
        "name": "x-arcanos-job-read-token",
        "in": "header",
        "required": true,
        "description": "Job-specific bearer capability returned as `jobReadToken` by the creating async response. Send exactly one header whose value is bound to this path job id; query-string, cookie, and body carriers are not accepted.",
        "schema": {
          "type": "string",
          "pattern": "^v1\\.[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "headers": {
      "NoStore": {
        "description": "The response must not be stored by clients or intermediary caches.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    },
    "schemas": {
      "JobReadUnavailable": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "JOB_READ_AUTH_UNAVAILABLE",
              "JOB_REPOSITORY_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "description": "Present for `JOB_READ_AUTH_UNAVAILABLE` and fixed to `Async job reads are temporarily unavailable.`"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RouteError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "details": {}
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "job_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lifecycle_status": {
            "type": "string"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancel_requested_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancel_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "retention_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "idempotency_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "poll": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {},
          "result": {}
        },
        "required": [
          "id",
          "jobId",
          "job_type",
          "status",
          "lifecycle_status",
          "created_at",
          "updated_at",
          "completed_at",
          "cancel_requested_at",
          "cancel_reason",
          "retention_until",
          "idempotency_until",
          "expires_at",
          "poll",
          "stream",
          "error_message",
          "output",
          "result"
        ],
        "additionalProperties": false
      }
    }
  }
}
