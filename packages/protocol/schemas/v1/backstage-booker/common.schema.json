{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json",
  "title": "Backstage Booker common definitions",
  "$defs": {
    "universeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "default": "legacy"
    },
    "continuityPathSegment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "continuityScopeKind": {
      "type": "string",
      "enum": [
        "page",
        "subtree"
      ],
      "default": "page"
    },
    "continuityPagePath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 101,
      "items": {
        "$ref": "#/$defs/continuityPathSegment"
      }
    },
    "continuitySectionPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/continuityPathSegment"
      }
    },
    "continuityRetrievalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageTitle"
      ],
      "properties": {
        "pageTitle": {
          "$ref": "#/$defs/continuityPathSegment"
        },
        "pagePath": {
          "$ref": "#/$defs/continuityPagePath"
        },
        "scopeKind": {
          "$ref": "#/$defs/continuityScopeKind"
        },
        "sectionPath": {
          "$ref": "#/$defs/continuitySectionPath"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "scopeKind"
            ],
            "properties": {
              "scopeKind": {
                "const": "subtree"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "sectionPath"
              ]
            }
          }
        }
      ]
    },
    "continuityResolvedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageTitle",
        "pagePath"
      ],
      "properties": {
        "pageTitle": {
          "$ref": "#/$defs/continuityPathSegment"
        },
        "pagePath": {
          "$ref": "#/$defs/continuityPagePath"
        },
        "scopeKind": {
          "const": "subtree"
        },
        "sectionPath": {
          "$ref": "#/$defs/continuitySectionPath"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "scopeKind"
            ],
            "properties": {
              "scopeKind": {
                "const": "subtree"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "sectionPath"
              ]
            }
          }
        }
      ]
    },
    "continuityCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]{1,1024}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "continuityCategory": {
      "type": "string",
      "enum": [
        "championships",
        "events",
        "general",
        "kayfabe",
        "nxt",
        "raw",
        "roster",
        "smackdown",
        "storylines"
      ]
    },
    "postgresText": {
      "type": "string",
      "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "postgresJsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/postgresText"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postgresJsonValue"
          }
        },
        {
          "$ref": "#/$defs/postgresJsonObject"
        }
      ]
    },
    "postgresJsonObject": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/postgresText"
      },
      "additionalProperties": {
        "$ref": "#/$defs/postgresJsonValue"
      }
    },
    "wrestlerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S",
      "allOf": [
        {
          "$ref": "#/$defs/postgresText"
        }
      ]
    },
    "wrestler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "overall"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/wrestlerName"
        },
        "overall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "hrc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "resilience",
        "verdict"
      ],
      "properties": {
        "fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resilience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "protectedGenerationProvenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "protected", "protectedGenerationCompleted", "official", "continuityVerified", "authority", "snapshotStatus", "fallbackUsed", "fallbackPermitted"],
          "properties": {
            "version": { "const": 1 },
            "protected": { "const": true },
            "protectedGenerationCompleted": { "const": true },
            "official": { "const": true },
            "continuityVerified": { "const": true },
            "authority": { "const": "notion" },
            "snapshotStatus": { "const": "current_complete" },
            "fallbackUsed": { "const": false },
            "fallbackPermitted": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "protected", "protectedGenerationCompleted", "official", "continuityVerified", "authority", "snapshotStatus", "fallbackUsed", "fallbackPermitted"],
          "properties": {
            "version": { "const": 1 },
            "protected": { "const": true },
            "protectedGenerationCompleted": { "const": true },
            "official": { "const": true },
            "continuityVerified": { "const": true },
            "authority": { "const": "legacy_postgresql" },
            "snapshotStatus": { "const": "not_applicable" },
            "fallbackUsed": { "const": false },
            "fallbackPermitted": { "const": false }
          }
        }
      ]
    },
    "durablePersistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "durable",
        "backend",
        "degraded"
      ],
      "properties": {
        "status": {
          "const": "durable"
        },
        "durable": {
          "const": true
        },
        "backend": {
          "const": "postgresql"
        },
        "degraded": {
          "const": false
        }
      }
    },
    "nonDurablePersistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "durable",
        "backend",
        "degraded",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "non_durable"
        },
        "durable": {
          "const": false
        },
        "backend": {
          "const": "process-memory"
        },
        "degraded": {
          "const": true
        },
        "reason": {
          "enum": [
            "database_unavailable",
            "database_write_failed"
          ]
        }
      }
    },
    "unknownPersistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "durable",
        "backend",
        "degraded",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "durable": {
          "type": "null"
        },
        "backend": {
          "const": "postgresql"
        },
        "degraded": {
          "const": true
        },
        "reason": {
          "const": "commit_outcome_unknown"
        }
      }
    },
    "persistence": {
      "oneOf": [
        {
          "$ref": "#/$defs/durablePersistence"
        },
        {
          "$ref": "#/$defs/nonDurablePersistence"
        },
        {
          "$ref": "#/$defs/unknownPersistence"
        }
      ]
    },
    "matchInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrestler1",
        "wrestler2",
        "matchType"
      ],
      "properties": {
        "wrestler1": {
          "$ref": "#/$defs/wrestlerName"
        },
        "wrestler2": {
          "$ref": "#/$defs/wrestlerName"
        },
        "matchType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "kayfabeMode": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "matchLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "matchRating": {
      "type": "string",
      "pattern": "^(?:[1-4]\\.[0-9]|5\\.0)$"
    },
    "interference": {
      "oneOf": [
        {
          "$ref": "#/$defs/wrestlerName"
        },
        {
          "type": "null"
        }
      ]
    },
    "kayfabeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "result",
        "via",
        "interference",
        "rating"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/matchLabel"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "via": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "interference": {
          "$ref": "#/$defs/interference"
        },
        "rating": {
          "$ref": "#/$defs/matchRating"
        }
      }
    },
    "realResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "winner",
        "loser",
        "probability",
        "interference",
        "rating"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/matchLabel"
        },
        "winner": {
          "$ref": "#/$defs/wrestlerName"
        },
        "loser": {
          "$ref": "#/$defs/wrestlerName"
        },
        "probability": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{2}|1\\.00)$"
          }
        },
        "interference": {
          "$ref": "#/$defs/interference"
        },
        "rating": {
          "$ref": "#/$defs/matchRating"
        }
      }
    },
    "matchResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/kayfabeResult"
        },
        {
          "$ref": "#/$defs/realResult"
        }
      ]
    }
  }
}
