{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/canon.schema.json",
  "title": "Backstage Booker canon and storyline definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "mutationId": {
      "$ref": "#/$defs/uuid"
    },
    "universeRevision": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^(?!0000-)(?:(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "storylineKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S",
      "allOf": [
        {
          "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json#/$defs/postgresText"
        }
      ]
    },
    "storylineTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S",
      "allOf": [
        {
          "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json#/$defs/postgresText"
        }
      ]
    },
    "storylineSummary": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 10000,
          "allOf": [
            {
              "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json#/$defs/postgresText"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "storylineStatus": {
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "participantNames": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json#/$defs/wrestlerName"
      }
    },
    "storylineInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "summary",
        "status",
        "participantNames"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/storylineKey"
        },
        "title": {
          "$ref": "#/$defs/storylineTitle"
        },
        "summary": {
          "$ref": "#/$defs/storylineSummary"
        },
        "status": {
          "$ref": "#/$defs/storylineStatus"
        },
        "participantNames": {
          "$ref": "#/$defs/participantNames"
        }
      }
    },
    "storyline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "title",
        "summary",
        "status",
        "participantNames",
        "version",
        "universeRevision",
        "createdAt",
        "updatedAt",
        "closedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "$ref": "#/$defs/storylineKey"
        },
        "title": {
          "$ref": "#/$defs/storylineTitle"
        },
        "summary": {
          "$ref": "#/$defs/storylineSummary"
        },
        "status": {
          "$ref": "#/$defs/storylineStatus"
        },
        "participantNames": {
          "$ref": "#/$defs/participantNames"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "universeRevision": {
          "$ref": "#/$defs/universeRevision"
        },
        "createdAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "closedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "canonBeatKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
    },
    "canonBeatSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "allOf": [
        {
          "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/common.schema.json#/$defs/postgresText"
        }
      ]
    },
    "canonBeatInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "occurredAt",
        "participantNames"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/canonBeatKind"
        },
        "summary": {
          "$ref": "#/$defs/canonBeatSummary"
        },
        "occurredAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "participantNames": {
          "$ref": "#/$defs/participantNames"
        },
        "eventId": {
          "$ref": "#/$defs/uuid"
        },
        "supersedesBeatId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "canonBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "storylineId",
        "storylineKey",
        "sequence",
        "kind",
        "summary",
        "occurredAt",
        "participantNames",
        "eventId",
        "supersedesBeatId",
        "universeRevision",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "storylineId": {
          "$ref": "#/$defs/uuid"
        },
        "storylineKey": {
          "$ref": "#/$defs/storylineKey"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "kind": {
          "$ref": "#/$defs/canonBeatKind"
        },
        "summary": {
          "$ref": "#/$defs/canonBeatSummary"
        },
        "occurredAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "participantNames": {
          "$ref": "#/$defs/participantNames"
        },
        "eventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedesBeatId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "universeRevision": {
          "$ref": "#/$defs/universeRevision"
        },
        "createdAt": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    }
  }
}
