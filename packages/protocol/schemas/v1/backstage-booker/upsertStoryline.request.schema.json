    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "storyline": {
      "$ref": "https://schemas.arcanos.dev/protocol/v1/backstage-booker/canon.schema.json#/$defs/storylineInput"
    }
