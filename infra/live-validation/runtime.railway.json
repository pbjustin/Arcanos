{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/live-validation/runtime.railway.Dockerfile"
  },
  "deploy": {
    "startCommand": "node /app/scripts/start-live-validation-runtime.mjs",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
