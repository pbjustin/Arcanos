# Arcanos backend environment template
# Copy to .env and fill real values.

# Required at backend startup (src/config/env.ts)
PORT=3000

# Core runtime
NODE_ENV=development
# HOST=127.0.0.1
# SERVER_URL=http://127.0.0.1:3000
# Base URL used by CLI/scripts before SERVER_URL/BACKEND_URL fallbacks.
# ARCANOS_BACKEND_URL=http://127.0.0.1:3000
# Optional browser CORS allowlist outside development. Use comma-separated
# exact HTTP(S) origins only; omit it to disable cross-origin browser access.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Atomic caller and deployment ceilings shared by public provider-capable HTTP
# routes. Production always uses lifecycle-owned Redis; development/test use
# memory unless the store is explicitly set to redis. Global max range:
# 1..1000000; client max range: 1..max(1, global max - 1); window range:
# 1000..2592000000 ms. Railway derives a stable namespace from project,
# environment, and service IDs. Non-Railway Redis deployments must set one.
PUBLIC_PROVIDER_RATE_LIMIT_MAX=100
PUBLIC_PROVIDER_CLIENT_RATE_LIMIT_MAX=20
PUBLIC_PROVIDER_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_PROVIDER_RATE_LIMIT_STORE=memory
# PUBLIC_PROVIDER_RATE_LIMIT_NAMESPACE=local_arcanos
# Railway `X-Real-IP` trust is opt-in and additionally requires a validated
# Railway edge marker plus an immediate peer in the documented proxy range.
# PUBLIC_PROVIDER_TRUST_RAILWAY_REAL_IP=false

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_RETRIES=2
# Production/Railway fails fast without OPENAI_API_KEY unless this rollback flag is false.
# OPENAI_API_KEY_REQUIRED=true
# Local/CI mock controls; keep false in production.
# ALLOW_MOCK_OPENAI=false
# FORCE_MOCK=false

# Standalone arcanos-ai-runtime workspace (not started by the root backend or
# canonical Railway launcher). Configure all three HTTP identity values before
# starting its API. The access token is accepted only as one exact Bearer value
# and must be a distinct 32–4096 character non-placeholder credential.
# Keep the principal ID stable across replicas and token rotations so existing
# owned jobs remain readable. Grant only the operations the caller needs.
# ARCANOS_AI_RUNTIME_ACCESS_TOKEN=
# ARCANOS_AI_RUNTIME_PRINCIPAL_ID=operator:ai-runtime
# ARCANOS_AI_RUNTIME_SCOPES=runtime:enqueue,runtime:read
# Required server-owned job policy; choose values for the deployed provider
# account and workload rather than copying an assumed production model/budget.
# AI_RUNTIME_ALLOWED_MODELS=
# AI_RUNTIME_DEFAULT_MAX_TOKENS=
# AI_RUNTIME_MAX_TOKENS=
# Required shared Redis admission policy. Choose deployment-specific limits;
# the standalone API and worker refuse startup when any value is absent or
# malformed. Claim grace must cover WATCHDOG_LIMIT_MS plus reconciliation time.
# AI_RUNTIME_ADMISSION_MAX_OUTSTANDING=
# AI_RUNTIME_ADMISSION_RATE_MAX=
# AI_RUNTIME_ADMISSION_RATE_WINDOW_MS=
# AI_RUNTIME_ADMISSION_PENDING_GRACE_MS=
# AI_RUNTIME_ADMISSION_MISSING_CONFIRM_MS=
# AI_RUNTIME_ADMISSION_RECONCILE_INTERVAL_MS=
# AI_RUNTIME_ADMISSION_RECONCILE_BATCH_SIZE=
# AI_RUNTIME_ADMISSION_CLAIM_GRACE_MS=
# Preferred standalone runtime Redis target. Use rediss:// when the deployment
# requires transport security; encode ACL credentials in the secret value, not
# in source or logs. This takes precedence over the legacy host/port pair.
# Required stable environment/version namespace shared by the standalone API
# and worker. Coordinate a drain or versioned cutover before changing it.
# AI_RUNTIME_QUEUE_NAME=
# AI_RUNTIME_REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# The standalone HTTP process does not read OPENAI_API_KEY; configure the
# existing provider key only on the standalone worker process.
# AI_RUNTIME_SHUTDOWN_TIMEOUT_MS=10000
# AI_RUNTIME_WORKER_STARTUP_TIMEOUT_MS=30000
# AI_RUNTIME_JOB_RETENTION_SECONDS=3600
# AI_RUNTIME_MAX_COMPLETED_JOBS=1000
# AI_RUNTIME_MAX_FAILED_JOBS=1000

# GPT-OSS separation. Railway remains web/worker/control plane; local WSL or an
# external GPU host handles GPT-OSS. Do not set Railway OPENAI_BASE_URL to local
# 127.0.0.1/localhost. Use GPTOSS_API_BASE_URL for cloud GPT-OSS.
# GPTOSS_LOCAL_ENABLED=false
# GPTOSS_LOCAL_API_BASE_URL=http://127.0.0.1:11434/v1
# GPTOSS_LOCAL_MODEL=gpt-oss
# GPTOSS_LOCAL_HEALTH_TIMEOUT_MS=5000
# GPTOSS_API_BASE_URL=https://your-gptoss-gateway.example/v1
# OPENAI_REFERENCE_MODEL=ft:gpt-4.1-2025-04-14:personal:arcanos:DIbLRZm2
# ARCANOS_REFERENCE_MODEL_ROLE=evaluate_only
# GPTOSS_MODEL=openai/gpt-oss-20b
# ARCANOS_MODEL_PROVIDER=hybrid_trinity
# ARCANOS_LOCAL_GPU_DYNAMIC=true
# ARCANOS_VRAM_MIN_FREE_MB=10500
# ARCANOS_VRAM_BALANCED_FREE_MB=12500
# ARCANOS_VRAM_PERFORMANCE_FREE_MB=14500
# ARCANOS_TRAINING_ALLOW_SWAP=false
# ARCANOS_CAPTURE_OPENAI_OUTPUT=false
# ARCANOS_USE_OPENAI_OUTPUT_FOR_TRAINING=false
# ARCANOS_REFERENCE_OUTPUT_TTL_SECONDS=0
# ARCANOS_TRAINING_DATA_SOURCE=owned_specs_only
# ARCANOS_REQUIRE_HUMAN_DATASET_APPROVAL=true

# Generic async job-read capabilities
# Required server-side before public job-backed `gpt` or `ask` work can be
# created or read through `/jobs/{id}`, `/jobs/{id}/result`, or
# `/jobs/{id}/stream`. Use a
# distinct 32–4096 character secret with no whitespace or placeholder text.
# The server derives per-job HMAC bearer capabilities from this value; it does
# not persist the bearer token. New tokens are always issued from this current
# key.
# ARCANOS_JOB_READ_CAPABILITY_SECRET=
# Optional verification-only prior key for a bounded rotation overlap. It must
# satisfy the same credential rules and differ from the current key and every
# other purpose-bound application credential. Configure the old key here while
# deploying a new current key, then remove it after the maximum retained-job
# window has drained. It never signs new tokens.
# ARCANOS_JOB_READ_CAPABILITY_PREVIOUS_SECRET=
# Client-only convenience for one standalone CLI/daemon job lookup. Set this
# transiently to the `jobReadToken` returned by job creation; do not configure
# it as a shared server secret or commit a real token.
# ARCANOS_JOB_READ_TOKEN=

# Custom GPT Action -> GPT ID bridge
# Shared secret accepted as `Authorization: Bearer ...` or `x-openai-action-secret`.
OPENAI_ACTION_SHARED_SECRET=replace-with-a-strong-shared-secret
DEFAULT_GPT_ID=arcanos-core
# Optional comma-separated GPT IDs that must be registered at startup.
# REQUIRED_GPT_IDS=arcanos-core,core
# Optional legacy/custom GPT ID alias for ARCANOS:GAMING.
# GPTID_ARCANOS_GAMING=arcanos-gaming
# Optional bounded wait for `query_and_wait` before falling back to `/jobs/{id}` polling.
# OPENAI_ACTION_BRIDGE_WAIT_TIMEOUT_MS=3500
# Optional wait for plain `query`; keep `0` for immediate async responses.
# OPENAI_ACTION_BRIDGE_QUERY_WAIT_TIMEOUT_MS=0
# OPENAI_ACTION_BRIDGE_POLL_INTERVAL_MS=250
# Rolling health window for bridge failure counters.
# OPENAI_ACTION_BRIDGE_FAILURE_COUNTER_WINDOW_MS=900000
# Background module dispatch timeout for GPT routes; clamped by the dispatcher.
# GPT_BACKGROUND_DISPATCH_TIMEOUT_MS=180000

# Generic GPT Access Gateway (/gpt-access/*)
# Required in production. Accepted only as `Authorization: Bearer ...`.
# Set ARCANOS_GPT_ACCESS_TOKEN out of band; never commit or document a real value.
# ARCANOS_GPT_ACCESS_TOKEN=replace-with-a-strong-token
# Required in production for /gpt-access/openapi.json. Falls back to ARCANOS_BASE_URL,
# ARCANOS_BACKEND_URL, SERVER_URL, BACKEND_URL, Railway public URL/domain, or local request origin.
# ARCANOS_GPT_ACCESS_BASE_URL=https://your-backend.example
# Optional comma-separated scope restriction. Empty enables existing read/control defaults only;
# jobs.create, capabilities.read, capabilities.run, and workers.recover must be
# listed explicitly before they can enqueue, discover, or execute capability work,
# or recover stale worker jobs. Add workers.recover only for an intentionally
# enabled, confirmation-gated recovery workflow.
# ARCANOS_GPT_ACCESS_SCOPES=runtime.read,workers.read,queue.read,jobs.create,jobs.result,logs.read_sanitized,db.explain_approved,mcp.approved_readonly,capabilities.read,capabilities.run,diagnostics.read
# Backstage Booker protected Custom GPT operations (web service only)
# Optional dedicated Bearer credential for the Builder's
# POST /gpt/backstage-booker continuity-query/generation/simulation operation,
# the poll-only managed result read at
# GET /gpt-access/capabilities/v1/backstage-booker/jobs/{jobId}/result, the read-only
# GET /gpt-access/capabilities/v1/backstage-booker/universes/{universeId}, its
# fixed /storyline-summary exact-key leaf, and POST
# /gpt-access/capabilities/v1/backstage-booker/run with only
# the upsertStoryline and appendCanonBeat actions. Use an exact 32–4096-character
# visible-ASCII non-placeholder value with no whitespace, distinct from every
# other purpose-bound application credential. Do not set it on worker services.
# Configure the same value in ChatGPT Builder as an API Key with Bearer auth;
# schema 1.6.0 declares it on every Builder operation. It authenticates one
# shared purpose-bound managed principal, not an end user, session, or tenant.
# New 1.6.0 jobs bind to that stable principal so future Action-token rotation
# does not change their owner. During the rollout, the result route also accepts
# the exact current token-derived owner of a pre-1.6.0 job. That read fallback
# does not alias the old idempotency scope: retain jobId, never resubmit legacy
# work as a lookup, and drain both result-retention and idempotency windows
# before the first token rotation because no previous Action-token setting
# exists. Result continuation is polling only and exposes no bearer SSE stream.
# It is not OAuth and is not a user password. All three exact reads are
# non-consequential and the generic GPT Access token cannot authorize them. For
# the canon write, ChatGPT's consequential-action approval banner is the
# approval step, so the backend does not issue its second confirmation
# challenge. Phase One mutations are
# unavailable on this lane and retain their existing authentication and
# backend confirmation on established generic/direct/control-plane/legacy
# paths. A universeId selects data scope only and never establishes
# authorization. Never put the real value in a schema, GPT instructions, chat,
# source, logs, or documentation.
# ARCANOS_BACKSTAGE_BOOKER_ACCESS_TOKEN=replace-with-a-distinct-backstage-booker-token
# Heavy generateBooking/generateBookingWithHRC automatic-queue rollout. Only
# exact true promotes workload-classified heavy requests; absent or malformed
# values use the false routing rollback. Explicit async or idempotent job-backed
# generation remains queued and protected regardless of this flag. Keep false
# until the same current payload key is present on both web and worker services.
# ARCANOS_BACKSTAGE_BOOKER_ASYNC_GENERATION_ENABLED=false
# Canonical base64 encoding of exactly 32 random bytes. This purpose-bound key
# encrypts private Booker job input and output at rest in job_data. It is
# required on web and worker for every job-backed Booker generation request,
# never in Builder or client requests.
# ARCANOS_BACKSTAGE_BOOKER_JOB_PAYLOAD_KEY=
# Optional decryption-only old key during a retained-job rotation. Stage the
# overlap in Railway deployment order: both roles K1/K2, then worker K2/K1,
# then web K2/K1. Remove K1 only after every K1-sealed retained job expires.
# ARCANOS_BACKSTAGE_BOOKER_JOB_PAYLOAD_PREVIOUS_KEY=
# Optional read-only Notion supplement for authenticated Backstage generation
# (web service only). Configure both values or neither. Create a dedicated
# Notion integration with read-content access, share only the intended pages
# with it, and use its provider token here. The token must be distinct from all
# ARCANOS application credentials and never belongs in ChatGPT Builder.
# Map each exact universeId to one to three raw Notion page UUIDs; URLs, duplicate
# IDs within one universe, unknown/unmapped universes, and partial/invalid
# configuration are ignored.
# A system policy directs the model to prefer PostgreSQL, but model adherence is
# not deterministic; this feature never writes Notion or Backstage data.
# Selected page excerpts are sent as separately delimited untrusted context, so
# map only content approved for that provider path and possible answer
# disclosure. Keep the legacy page mapping off worker services. When authority
# mode below is enabled, place the outbound token on the worker instead and do
# not use this direct supplement for the authoritative universe. Keep every
# value out of source, schemas, prompts, chat, and logs.
# ARCANOS_BACKSTAGE_NOTION_ACCESS_TOKEN=replace-with-a-read-content-only-notion-token
# ARCANOS_BACKSTAGE_NOTION_UNIVERSE_PAGES_JSON={"my-universe-2k26":["11111111-1111-4111-8111-111111111111"]}
# Optional Notion-authority mode. Set the same closed root mapping on web and
# worker so every backend mutation/read boundary fails closed for that exact
# universe while the worker maintains its derived retrieval index. Configure
# the outbound Notion token on the worker only for authority-only deployments;
# the web service reads PostgreSQL snapshots and never calls Notion directly.
# queryContinuity is request-local and synchronous-only; it never enters the
# worker queue. A scoped lookup defaults to one exact page. Explicit
# scopeKind=subtree includes that parent plus all descendants but no siblings;
# it supports blank navigation parents and rejects sectionPath. relevant remains
# a diversified bounded sample, while complete_scope follows opaque cursors.
# Schema 1.6.0 must be re-imported in Builder after the backend deployment.
# On a heading/index-format deployment, absent, invalid, or exact monolith
# partition policy makes worker readiness check every configured active monolith
# snapshot's page metadata before emitting the Railway readiness signal.
# Already-current snapshots require no Notion call; otherwise one synchronous
# full sync must activate or verify the current format and pass a database
# reload. Lease-busy, failed, or still-old results keep that policy unready.
# Exact valid shadow or partitioned skips only this universe-wide legacy gate so
# protected shard jobs can repair partition state; partition manifests and shard
# freshness never gate /readyz. Legacy reads still fail closed with
# BACKSTAGE_NOTION_INDEX_UNAVAILABLE when their snapshot is unavailable.
# initialMinimumPageCount protects the first cutover manifest only; later
# complete snapshots may intentionally contain fewer pages after a Notion edit.
# A present but malformed roots value blocks Backstage mutations globally until
# corrected. After the first successful activation, the PostgreSQL authority
# head is a durable one-way latch: removing this mapping does not restore legacy
# reads or writes, changing the root is rejected, and an unreadable authority
# head fails closed with BACKSTAGE_NOTION_AUTHORITY_UNAVAILABLE. Never include
# an authoritative universe in the legacy supplement mapping above.
# ARCANOS_BACKSTAGE_NOTION_AUTHORITY_ROOTS_JSON={"my-universe-2k26":{"rootPageId":"22222222-2222-4222-8222-222222222222","displayName":"WWE universe mode","initialMinimumPageCount":18}}
# Monolithic snapshot readers and writers both have a fixed 4,096-chunk ceiling.
# A candidate with 4,097 or more chunks fails at chunking before embedding,
# persistence, validation, or activation; it is never truncated. Deploy and
# verify 4,096-capable readers on every web and worker replica before allowing a
# worker with the raised writer fence to synchronize.
# The active snapshot pointer and latest synchronization attempt are independent.
# A failed refresh cannot clear a readable active snapshot: continuity may label
# it last_known_good with bounded failure/freshness metadata, but protected
# booking generation still requires current_complete and never treats it as current.
# Additive version-1 partition contract for the partition index. The operator-owned
# generation is recorded separately from the canonical semantic SHA-256 digest.
# Universe, shard, and tag order is canonicalized. Stable lowercase shardKey
# values, not display names, identify shards. Every shard has an explicit finite
# capacity policy; maxChunks remains bounded to 1-2048 per shard. Archive-tier
# shards are structurally optional and must declare required:false so an archive
# failure can never fence publication of unrelated current-canon shards.
# The controlled rollout uses the existing five-shard deployment configuration;
# shard identities and the required set come only from this closed configuration,
# never hard-coded service names. One source-generation capture must cover every
# configured shard before a complete manifest can publish atomically.
# ARCANOS_BACKSTAGE_NOTION_PARTITIONS_JSON={"version":1,"generation":"authority-2026.08.24-1","universes":[{"universeId":"my-universe-2k26","shards":[{"shardKey":"shared/current","rootPageId":"33333333-3333-4333-8333-333333333333","displayName":"Shared current canon","retrievalTier":"hot","required":true,"scopeTags":["shared"],"categoryTags":["current-canon"],"capacity":{"maxPages":256,"maxChunks":1024,"maxDepth":16,"maxContentCodePoints":2000000}},{"shardKey":"raw/2026","rootPageId":"44444444-4444-4444-8444-444444444444","displayName":"Monday Night Raw 2026","retrievalTier":"hot","required":true,"scopeTags":["brand:raw","year:2026"],"categoryTags":["current-canon"],"capacity":{"maxPages":512,"maxChunks":2048,"maxDepth":16,"maxContentCodePoints":4000000}},{"shardKey":"ples/2026","rootPageId":"55555555-5555-4555-8555-555555555555","displayName":"Premium live events 2026","retrievalTier":"cold","required":true,"scopeTags":["lane:ples","year:2026"],"categoryTags":["current-canon","events"],"capacity":{"maxPages":256,"maxChunks":1536,"maxDepth":16,"maxContentCodePoints":3000000}}]}]}
# Rollout control accepts only monolith, shadow, or partitioned. Absent, padded,
# differently cased, or unknown values resolve safely to monolith. Exact shadow
# keeps the monolith as the sole returned read while executing web reads and
# protected queued relevant worker reads may perform bounded partition
# comparisons; the worker also synchronizes partition shards. Exact
# partitioned serves only partition reads and fails closed without a monolith
# read fallback. The worker keeps both synchronization paths available for
# rollback. This repository change does not set or change the deployed value.
# A later partitioned cutover requires separately reviewed durable evidence for
# the exact configuration, source generation, reconciliation epoch, manifest,
# supported embedding/index contract, complete five-shard coverage, fresh
# readable rollback monolith, exact/relevant/complete-scope parity, and cursor
# stability. Changing modes invalidates in-flight complete-scope cursors from the
# other index, so restart pagination.
# ARCANOS_BACKSTAGE_NOTION_PARTITIONED_INDEX_MODE=monolith
# In exact shadow or partitioned mode, an authenticated operator with the
# backstage:notion-sync scope can enqueue one configured shard at a time through
# /api/backstage/notion-partitions/:universeId/syncs and inspect bounded,
# bodyless/query-free state through
# /api/backstage/notion-partitions/:universeId/diagnostics. Neither route accepts
# roots or raw configuration; enqueue additionally requires an Idempotency-Key
# plus a consumed, request-bound one-use confirmation challenge.
# Current server-only partition complete-scope cursor credential. Exact shadow or
# partitioned web reads require an exact 32-4096 UTF-8-byte, unpadded,
# non-placeholder value with no whitespace, distinct from every other
# purpose-bound credential. Never configure it in Builder, clients, or workers.
# ARCANOS_BACKSTAGE_NOTION_PARTITION_CURSOR_SECRET=
# Optional second cursor credential accepted only for unsealing during rotation.
# For rolling replicas, first deploy K1 current + K2 here everywhere and drain
# K1-only replicas; then deploy K2 current + K1 here everywhere. New cursors use
# the current secret. Remove K1 only after its cursors and rollback window drain.
# ARCANOS_BACKSTAGE_NOTION_PARTITION_CURSOR_PREVIOUS_SECRET=
# Worker-owned refresh cadence; bounded to 1 minute through 24 hours. Partition
# reconciliation uses the same cadence, starts after one interval, and still
# performs a bounded full Notion source scan before reusing immutable material.
# ARCANOS_BACKSTAGE_NOTION_SYNC_INTERVAL_MS=900000
# Web-side maximum age of the last successful full-manifest verification;
# bounded to 5 minutes through 7 days. Stale/missing indexes fail closed.
# ARCANOS_BACKSTAGE_NOTION_RAG_MAX_STALENESS_MS=86400000
# ARCANOS Gaming source lifecycle Actions (web service only)
# Optional dedicated Bearer credential for exactly the source ingestion,
# refresh, and status routes under /gpt-access/gaming/sources/*. Use an exact
# 32–4096-character visible-ASCII non-placeholder value with no whitespace,
# distinct from every other purpose-bound application credential. Do not set it
# on worker services. This credential never authenticates generic /gpt-access/*
# routes, and ARCANOS_GPT_ACCESS_TOKEN never authenticates these source routes.
# Configure this value, not the generic GPT Access or bridge secret, in the
# Arcanos Gaming Custom GPT Action authentication field.
# ARCANOS_GAMING_SOURCE_ACCESS_TOKEN=replace-with-a-distinct-gaming-source-token
# Server-controlled tenancy for GPT Access-only capabilities such as ARCANOS:PRODUCTIVITY.
# Never accept these values from capability payloads or conversation state.
# ARCANOS_GPT_ACCESS_PRINCIPAL_ID=operator:primary
# ARCANOS_GPT_ACCESS_WORKSPACE_ID=personal
# Privileged worker-control credential for protected /worker-helper/* operations,
# POST /workers/heal, and POST /workers/run/:workerId. Use an exact 32–4096
# character value with no whitespace or placeholder text, distinct from every
# credential in the
# canonical ARCANOS application-auth registry. Inbound callers may use one
# custom-header or Bearer carrier. The bundled helper's public status command
# remains credential-free; every protected helper command reads this environment
# value only (there is no credential flag), validates it locally, and sends only
# x-arcanos-worker-helper-token. Configure the identical value on caller and
# target. Protected outbound requests reject redirects and require an exact
# explicit HTTPS origin; exact HTTP loopback origins are the only exception.
# ARCANOS_WORKER_HELPER_TOKEN=
# Deployment-wide transport credential for every /api/daemon/* route. Use one
# exact 32–4096 character value with no whitespace or placeholder text,
# distinct from every other purpose-bound application credential. Configure the
# same value on the backend and bundled Python daemon. The daemon sends it only
# as x-arcanos-daemon-token; Bearer, GPT-ID, cookies, query values, and request
# bodies never carry daemon-plane authority. This blocks anonymous transport
# access but does not identify or isolate individual daemon instances.
# ARCANOS_DAEMON_ACCESS_TOKEN=
# Deployment-wide credential for /api/memory/*, /api/save-conversation*,
# /api/sessions*, and the exact natural-language memory-interception branch of
# POST /gpt/:gptId.
# Use an exact 32–4096 character value with no whitespace or placeholder text,
# distinct from every other purpose-bound application credential. Clients must
# send it only as x-arcanos-memory-token; Authorization, cookies, query values,
# and request-body fields never carry memory authority. This token does not
# establish tenant identity or ownership of a caller-selected sessionId.
# ARCANOS_MEMORY_ACCESS_TOKEN=
# Optional remote worker-helper repair origin. If compatibility aliases
# WORKER_HELPER_BASE_URL, RAILWAY_SERVICE_ARCANOS_WORKER_URL, or
# ARCANOS_WORKER_PUBLIC_URL are also set, every value must normalize to the same
# exact origin or the remote actuator remains unavailable.
# SELF_HEAL_WORKER_SERVICE_URL=https://worker.example.com
# Purpose-bound HTTP control-plane identity for control-plane routes, direct
# /system-state, legacy POST /status, /rag/*, reinforcement feedback and
# memory inspection, /api/arcanos/dag/*, /api/commands*, and
# /api/agent/execute access,
# protected diagnostic execution,
# /api/self-heal/*, /api/self-improve/*, detailed GET
# /status/safety/self-heal, and quarantine release.
# Configure all three values together. The access token must be 32–4096 visible
# ASCII characters with no whitespace and distinct from GPT Access, approval,
# ActionPlan, MCP, local-agent, automation, and other administrative credentials.
# The direct self-heal scope
# names are documented below; missing scopes grant no operations.
# Self-heal reads require arcanos:read; active provider probes additionally
# require self-heal:probe. Decisions require self-heal:decide, and a request with
# execute=true additionally requires self-heal:execute. Manual self-improve runs
# require both decision and execution scopes; freeze, unfreeze, and autonomy
# changes and integrity-quarantine release require self-improve:control. Grant
# active scopes only for deliberate, short-lived operator workflows.
# Repository-file inspection requires repo:read; raw prompt-debug trace reads
# require arcanos:read. POST /devops/self-test and /devops/daily-summary require
# diagnostics:execute. POST /api/pr-analysis/analyze requires repo:verify.
# Legacy SDK/orchestration status reads require arcanos:read; SDK mutations and
# orchestration reset/purge require mcp:invoke plus explicit confirmation.
# Backstage bookEvent, updateRoster, trackStoryline, saveStoryline,
# upsertStoryline, and appendCanonBeat actions require mcp:invoke plus explicit
# confirmation across every public HTTP alias.
# Generation and simulation remain public; /backstage/book-gpt is protected
# because it saves its generated storyline.
# GET /system-state requires arcanos:read. POST /system-state requires
# mcp:invoke plus its issued, one-use confirmation challenge; manual or trusted
# confirmation shortcuts do not apply.
# Legacy POST /status requires mcp:invoke plus its existing explicit
# confirmation contract; its JSON body is capped at 64 KiB before broad parsing.
# POST /rag/query requires arcanos:read. POST /rag/fetch and /rag/save require
# mcp:invoke plus an issued, one-use confirmation challenge; these routes use
# fixed operation-specific body limits and address one shared operator corpus.
# GET and HEAD /api/arcanos/dag/* reads require arcanos:read. Creating or
# cancelling a DAG run requires mcp:invoke.
# GET and HEAD /api/commands and /api/commands/health require arcanos:read.
# POST /api/commands/execute and /api/agent/execute require mcp:invoke; their
# strict JSON bodies are capped at 256 KiB before the broad application parser.
# GET and HEAD /memory, /memory/digest, and /reinforcement/metrics require
# arcanos:read. POST /reinforce, /audit, and /reinforcement/judge require
# mcp:invoke. Reinforce JSON is capped at 32 KiB; audit and judge JSON at
# 128 KiB. These feedback routes do not add a confirmation challenge; the
# current legacy /audit owner retains its existing confirmation requirement.
# ARCANOS_CONTROL_PLANE_ACCESS_TOKEN=replace-with-a-distinct-strong-token
# ARCANOS_CONTROL_PLANE_PRINCIPAL_ID=operator:control-plane
# ARCANOS_CONTROL_PLANE_SCOPES=railway:read,arcanos:read,repo:read,mcp:read,mcp:invoke,self-heal:decide,backstage:notion-sync
# GET and HEAD /api/assistants and /api/assistants/:name require arcanos:read.
# POST /api/assistants/sync requires mcp:invoke plus its issued, one-use,
# principal- and assistant-registry-workspace-bound confirmation challenge.
# Reads never contact the provider. The registry parent directory must already
# exist; an existing target must be a regular non-symlink file.
# ASSISTANT_REGISTRY_PATH=config/assistants.json
# One-shot `npm run assistants-sync` backend client. HTTPS is required except
# for exact HTTP loopback. The client refuses redirects and caps responses.
# ASSISTANTS_BACKEND_URL=http://127.0.0.1:3000
# ASSISTANTS_SYNC_TIMEOUT_MS=10000
# Optional exact challenge after operator approval; `--challenge` is preferred.
# ASSISTANTS_SYNC_CONFIRMATION_CHALLENGE=
# AFOL files contain bounded categorical metadata only. Paths resolve through a
# validated canonical parent; existing targets must be regular non-symlink
# files. Retention is clamped to 1-1000 records, and tail reads to 1 KiB-4 MiB.
# AFOL_ANALYTICS_PATH=logs/afol-analytics.json
# AFOL_ANALYTICS_RECENT_LIMIT=50
# AFOL_LOG_PATH=logs/afol-decisions.log
# AFOL_LOG_RETENTION_LIMIT=100
# AFOL_LOG_TAIL_BYTES=524288
# Optional repository root for /api/codebase reads. When set, it must resolve to
# a directory containing package.json; invalid values fail closed.
# CODEBASE_ROOT=/absolute/path/to/repository
# Prompt and AI-routing traces default to bounded, in-memory metadata. Use
# exactly off, metadata, or full; an invalid non-empty mode fails closed to off.
# Full mode can retain sensitive prompt/response prose even after credential
# redaction and should be temporary.
# PROMPT_DEBUG_TRACE_MODE=metadata
# Disk persistence is separately opt-in and requires an explicit 1 KiB–100 MiB
# cap. Setting a path alone never enables reads or writes.
# PROMPT_DEBUG_TRACE_PERSIST=false
# PROMPT_DEBUG_TRACE_MAX_BYTES=8388608
# PROMPT_DEBUG_EVENTS_PATH=logs/prompt-debug-events.jsonl
# Protected ARCANOS:LOCAL_AGENT bridge. The executor values must match one
# authoritative Agent record with only the listed local-agent capabilities.
# This credential has the dedicated local-agent-protocol audience and only
# heartbeat, claim, job-heartbeat, and result scopes. It must not reuse GPT
# Access, ActionPlan requester/operator/executor, or administrative tokens.
# Keep the current token out of source control and configure it independently
# on the backend and paired Python daemon.
# ARCANOS_LOCAL_AGENT_EXECUTOR_TOKEN=replace-with-a-local-agent-only-token
# ARCANOS_LOCAL_AGENT_EXECUTOR_PRINCIPAL_ID=local-agent:executor
# ARCANOS_LOCAL_AGENT_EXECUTOR_INSTANCE_ID=local-agent:workstation-1
# ARCANOS_LOCAL_AGENT_EXECUTOR_DEVICE_ID=00000000-0000-4000-8000-000000000000
# Optional one-token rotation overlap. Configure both values together. The
# expiry must be an ISO-8601 UTC timestamp no more than 24 hours in the future.
# Remove both values after every daemon uses the current token.
# ARCANOS_LOCAL_AGENT_EXECUTOR_PREVIOUS_TOKEN=
# ARCANOS_LOCAL_AGENT_EXECUTOR_PREVIOUS_TOKEN_EXPIRES_AT=<ISO-8601-UTC-no-more-than-24h-ahead>
# ARCANOS_LOCAL_AGENT_WORKSPACES=personal
# ARCANOS_LOCAL_AGENT_JOB_TTL_MS=1200000
# ARCANOS_LOCAL_AGENT_LEASE_MS=30000
# Fresh-heartbeat window used before a GPT request can enqueue device work;
# clamped to 10000-900000 ms and defaults to 90000.
# ARCANOS_LOCAL_AGENT_HEARTBEAT_TTL_MS=90000
# Natural-language dispatch: rules, hybrid, or llm_first.
# When unset, a real resolved OpenAI key makes the gateway use hybrid; missing/mock/placeholder keys use rules.
# Resolved keys follow OPENAI_API_KEY, RAILWAY_OPENAI_API_KEY, API_KEY, then OPENAI_KEY.
# Invalid mode values resolve to rules. LLM timeout/failure never executes an LLM plan and can only fall back through rules/policy.
# GPT_ACCESS_NL_DISPATCH_MODE=
# GPT_ACCESS_DISPATCH_MODEL=gpt-4.1-mini
# GPT_ACCESS_DISPATCH_LLM_TIMEOUT_MS=5000  # capped at 10000

# Optional ARCANOS CLI bridge capability. Disabled by default.
# ARCANOS:CLI appears under /gpt-access/capabilities/v1 with enabled:false unless
# enabled. When enabled, it uses the local Python daemon bridge; it must not be
# used as a general shell proxy.
ARCANOS_CLI_BRIDGE_ENABLED=false
ARCANOS_CLI_BRIDGE_URL=http://127.0.0.1:8765
ARCANOS_CLI_BRIDGE_TOKEN=
ARCANOS_CLI_SANDBOX_ROOT=
ARCANOS_WORKSPACE_ROOT=
ARCANOS_CLI_COMMAND_TIMEOUT_MS=30000
ARCANOS_CLI_OUTPUT_MAX_BYTES=20000

# Legacy ask-style route migration. Default is `gone`; set `compat` only while
# migrating old `/brain` callers to `/gpt/:gptId`.
# ASK_ROUTE_MODE=gone

# Production safety controls
ALLOW_MOCK_FALLBACK=false
BUDGET_DISABLED=false
WATCHDOG_LIMIT_MS=120000
SAFETY_BUFFER_MS=2000
TRINITY_BASE_SOFT_CAP_MS=60000
TRINITY_MULT_SIMPLE=1.0
TRINITY_MULT_COMPLEX=1.4
TRINITY_MULT_CRITICAL=1.8
# Gaming module provider budgets. Generic values apply to guide/build/meta.
# Raising ARCANOS_GAMING_MODULE_TIMEOUT_MS can expand provider pipeline defaults
# while preserving the normal mode defaults at the documented 60s module budget.
# ARCANOS_GAMING_PIPELINE_TIMEOUT_MS=35000
# ARCANOS_GAMING_GUIDE_PIPELINE_TIMEOUT_MS=50000
# ARCANOS_GAMING_STAGE_TIMEOUT_MS=12000
# ARCANOS_GAMING_GUIDE_STAGE_TIMEOUT_MS=24000
# Route queued Trinity DAG node execution through the GPT Access gateway job path.
# Leave unset to enable automatically only when worker slots are greater than DAG_MAX_CONCURRENT_NODES.
# Set true only after provisioning nested queue capacity; unsafe forced routing fails clearly.
# Set false for local legacy bridge debugging.
# TRINITY_DAG_GPT_ACCESS_ENABLED=true
# Optional debug-only route. Leave disabled in production.
# DEBUG_WATCHDOG=false
# Required whenever DEBUG_WATCHDOG=true: use a distinct 32-4096 character
# purpose-bound credential with no surrounding whitespace or placeholder value.
# DEBUG_WATCHDOG_KEY=<store-outside-source-control>

# ================================
# Deployment & Runtime Overrides
# ================================

# Railway / Platform
# Railway environment identifier (set automatically on Railway)
# RAILWAY_ENVIRONMENT=production
# Railway service name (set automatically on Railway)
# RAILWAY_SERVICE_NAME=your-service-name
# Explicit Railway runtime contract for the shared launcher.
# Leave this unset for local direct runtime so RUN_WORKERS remains authoritative.
# - Railway web service: ARCANOS_PROCESS_KIND=web
# - Railway worker service: ARCANOS_PROCESS_KIND=worker
# ARCANOS_PROCESS_KIND=web
# One-shot Backstage durable proof only. Never set these on the canonical
# project or ordinary PR previews. Both disposable app roles use the same
# target/run/data identity markers; service IDs are supplied by the disposable
# four-service project. See docs/RAILWAY_DEPLOYMENT.md.
# ARCANOS_BACKSTAGE_HEAVY_PROOF_TARGET=dedicated-backstage-heavy-preview-v1
# ARCANOS_BACKSTAGE_HEAVY_PROOF_RUN_ID=proof-run-unique-id
# Exact lowercase 40-hex revision supplied by the disposable runner. A
# Railway-provided RAILWAY_GIT_COMMIT_SHA is optional but must match if present.
# ARCANOS_BACKSTAGE_HEAVY_PROOF_SOURCE_SHA=
# ARCANOS_BACKSTAGE_HEAVY_POSTGRES_SERVICE_ID=
# ARCANOS_BACKSTAGE_HEAVY_POSTGRES_SERVICE_NAME=Postgres
# ARCANOS_BACKSTAGE_HEAVY_POSTGRES_INTERNAL_HOST=postgres.railway.internal
# ARCANOS_BACKSTAGE_HEAVY_REDIS_SERVICE_ID=
# ARCANOS_BACKSTAGE_HEAVY_REDIS_SERVICE_NAME=Redis
# ARCANOS_BACKSTAGE_HEAVY_REDIS_INTERNAL_HOST=redis.railway.internal
# Worker-only credential-free fixture marker. The supervisor injects its fixed
# fictional SDK key only into the worker child; do not configure a provider key.
# ARCANOS_PREVIEW_OPENAI_FIXTURE=backstage-heavy-compact-retry-v1
# Worker DB bootstrap retry controls; max attempts 0 means retry indefinitely.
# JOB_WORKER_DB_BOOTSTRAP_RETRY_MS=5000
# JOB_WORKER_DB_BOOTSTRAP_MAX_RETRY_MS=30000
# JOB_WORKER_DB_BOOTSTRAP_MAX_ATTEMPTS=0

# Optional Railway management API token (only required for automation scripts/CI)
RAILWAY_API_TOKEN=
# Railway GraphQL API override
# RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.app/graphql/v2
# RAILWAY_GRAPHQL_TIMEOUT_MS=15000

# Public GPT response bounds
# Default falls back to CLIENT_RESPONSE_MAX_BYTES or 32768 bytes when unset.
# Set lower in preview/test to exercise explicit partial-response shaping.
# GPT_PUBLIC_RESPONSE_MAX_BYTES=8000
# Enables X-Debug-Max-Bytes for /gpt control responses outside production only.
# ARCANOS_ENABLE_DEBUG_GPT_CONTROLS=false

# Optional owner bootstrap (used only when identity modules are enabled).
# Use a verified email that should automatically receive owner/internal privileges.
ARCANOS_OWNER_EMAIL=you@example.com
# Optional comma-separated allowlist if you want more than one bootstrap owner email.
# ARCANOS_OWNER_EMAILS=you@example.com,alt@example.com

# Storage
# DATABASE_URL=postgresql://user:password@host:5432/database
# Optional private Railway-internal URL for in-platform services when DATABASE_URL is pointed at the public proxy.
# DATABASE_PRIVATE_URL=postgresql://user:password@postgres.railway.internal:5432/database?sslmode=no-verify
# Optional public proxy URL for local CLI/scripts when DATABASE_URL points at Railway private DNS.
# DATABASE_PUBLIC_URL=postgresql://user:password@public-proxy.rlwy.net:12345/database?sslmode=no-verify
# For local access to Railway Postgres, use the TCP proxy host/port and sslmode=no-verify.
# PGHOST=your-public-proxy.rlwy.net
# PGPORT=12345
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=replace-me
# Redis can use redis:// or TLS rediss:// via REDIS_URL, or Railway-style discrete variables.
# REDIS_URL=redis://localhost:6379
# REDISHOST=
# REDISPORT=6379
# REDISUSER=
# REDISPASSWORD=
ARC_LOG_PATH=/tmp/arc/log
ARC_MEMORY_PATH=/tmp/arc/memory

# Workers
# Local direct-runtime toggle used when ARCANOS_PROCESS_KIND is unset or when bypassing the Railway launcher.
# The API startup lifecycle explicitly boots this in-process runtime; importing shared worker code never does.
RUN_WORKERS=true
# OpenAI request timeout for worker API calls (ms)
WORKER_API_TIMEOUT_MS=60000
# Dedicated job-runner identity, concurrency, and polling controls.
# JOB_WORKER_ID=async-queue
# Exact worker-group identity shared by slot-level hourly budget accounting (max 255 characters).
# JOB_WORKER_STATS_ID=async-queue
# JOB_WORKER_CONCURRENCY=1
# DAG_MAX_CONCURRENT_NODES=1
# Per-process DAG run admission and lazy terminal-retention controls.
# Capacity is enforced independently by each web replica.
# DAG_MAX_ACTIVE_RUNS=4
# DAG_TERMINAL_RETENTION_MS=900000
# DAG_MAX_RETAINED_RUNS=100
# DAG_OVERLOAD_RETRY_AFTER_SECONDS=5
# JOB_WORKER_POLL_MS=250
# JOB_WORKER_IDLE_BACKOFF_MS=1000
# Queue lifecycle and retry controls.
JOB_WORKER_HEARTBEAT_MS=5000
# Claimed-job lease duration, clamped to 3000-300000ms; renewal runs at least
# every one-third lease and no slower than 10000ms while work/finalization is active.
# JOB_WORKER_LEASE_MS=30000
JOB_WORKER_STALE_AFTER_MS=45000
# Maximum stale jobs locked and transitioned by one recovery transaction.
# Defaults to 100 and is clamped to 1-1000; overflow drains on later passes.
# JOB_WORKER_RECOVERY_BATCH_SIZE=100
# JOB_WORKER_INSPECTOR_MS=30000
JOB_WORKER_WATCHDOG_MS=10000
JOB_WORKER_WATCHDOG_IDLE_MS=120000
# JOB_WORKER_STALLED_JOB_ACTION=dead_letter
# JOB_WORKER_MAX_RETRIES=2
# JOB_WORKER_RETRY_BASE_MS=2000
# JOB_WORKER_RETRY_MAX_MS=60000
# Retained failed-job cleanup. Disable with QUEUE_FAILED_JOB_CLEANUP_ENABLED=false to roll back.
# QUEUE_FAILED_JOB_CLEANUP_ENABLED=true
# QUEUE_FAILED_JOB_RETENTION_COUNT=50
# QUEUE_FAILED_JOB_CLEANUP_MIN_AGE_MS=86400000
# Successful/cancelled ask, DAG-node, and protected manual partition-sync result
# retention. Legacy rows without a deadline remain protected and are reported
# only as a bounded aggregate sample.
# QUEUE_ASK_TERMINAL_RETENTION_MS=86400000
# QUEUE_DAG_NODE_TERMINAL_RETENTION_MS=3600000
# QUEUE_BACKSTAGE_NOTION_PARTITION_SYNC_TERMINAL_RETENTION_MS=604800000
# QUEUE_NON_GPT_TERMINAL_CLEANUP_ENABLED=true
# QUEUE_NON_GPT_TERMINAL_CLEANUP_BATCH_SIZE=100
# Recent queue diagnostics window (1 minute-7 days). Terminal cleanup also
# protects at least this window and the one-hour worker-budget window.
# QUEUE_DIAGNOSTICS_FAILURE_WINDOW_MS=3600000
# Durable job event retention. Dry-run defaults true; set false after reviewing matched rows.
# JOB_EVENTS_CLEANUP_ENABLED=true
# JOB_EVENTS_RETENTION_DAYS=30
# JOB_EVENTS_CLEANUP_BATCH_SIZE=1000
# JOB_EVENTS_CLEANUP_DRY_RUN=true
# JOB_EVENT_RECORD_HEARTBEATS=false
# Hybrid async ask-style behavior: wait briefly for a queued worker result before falling back to HTTP 202 polling.
# Set to `0` to preserve strict fire-and-poll behavior.
# ASK_ASYNC_WAIT_FOR_RESULT_MS=15000
# Optional poll interval while the API waits on a queued ask-style job.
# ASK_ASYNC_WAIT_POLL_MS=250
# Optional artifact store backend for DAG dependency payload offloading.
# Defaults to `database` on Railway and `filesystem` elsewhere when unset.
# TRINITY_ARTIFACT_STORE_BACKEND=database
# Optional shared artifact directory for filesystem-backed DAG artifacts.
# Ignored when the artifact backend is `database`.
# Defaults to $RAILWAY_VOLUME_MOUNT_PATH/trinity-artifacts on Railway when unset.
# TRINITY_ARTIFACT_STORE_DIR=/data/trinity-artifacts
# Predictive autoscaling thresholds for the main Trinity worker pool.
# AUTOSCALING_MAIN_CPU_THRESHOLD=0.8
# AUTOSCALING_MAIN_MEMORY_PRESSURE_THRESHOLD=0.8
# AUTOSCALING_MAIN_API_LATENCY_THRESHOLD_MS=300
# AUTOSCALING_DOMAIN_SURGE_MULTIPLIER=3

# Scholarly (CrossRef) API
# CROSSREF_API_URL=https://api.crossref.org/works
# CROSSREF_API_TIMEOUT_MS=15000
# CROSSREF_DEFAULT_ROWS=3

# Confirmation and automation
# Trusted GPT IDs (comma-separated) used by confirmation middleware and optional backend-service GPT-ID auth.
# The trusted confirmation path also requires a non-empty x-arcanos-confirm-token
# presence marker. This is not caller authentication; use it only behind
# middleware that authenticates the caller and binds the permitted GPT identity.
# TRUSTED_GPT_IDS=
# Optional backend-service auth mode: api-key (default), gpt-id, hybrid
# AGENT_AUTH_MODE=api-key
# Optional backend-service specific GPT-ID allowlist override (falls back to TRUSTED_GPT_IDS)
# BACKEND_TRUSTED_GPT_IDS=
# ARCANOS_AUTOMATION_SECRET=
# ARCANOS_AUTOMATION_HEADER=x-arcanos-automation

# Optional model overrides
# FINETUNED_MODEL_ID=
# AI_MODEL=
# FALLBACK_MODEL=gpt-4
# Trinity-only structured Responses model. Defaults to Terra when this and the shared rollback
# selectors below are unset.
# TRINITY_REASONING_MODEL=gpt-5.6-terra
# Shared GPT-5 model override, followed by the explicit GPT-5.1 rollback.
# GPT5_MODEL=
# GPT51_MODEL=gpt-5.1
# Structured Responses cap includes hidden reasoning and visible JSON output. Strict positive
# base-10 integers are clamped to 16-8000; invalid or unset values use 8000.
# TRINITY_REASONING_MAX_OUTPUT_TOKENS=8000
# Structured reasoning stage timeout, also clamped to the remaining request/runtime budget.
# TRINITY_REASONING_STAGE_TIMEOUT_MS=20000
# Standard synchronous Backstage Booker direct-answer budget. Positive values are honored up to
# the standard 2400-token cap; full-show/card review-only prompts use at most 1600 and may
# be lowered further for compact prompts while ordinary Trinity callers retain the 1200-token cap.
# Deployments retaining 512 or 1200 must remove or update it to receive the 2400-token default.
# BOOKER_TOKEN_LIMIT=2400
# Protected queued structured generation uses a workload- and stage-aware finite budget.
# Values clamp to 4000-8000; the default is 6000. Compact, review, continuity, unsupported-model,
# and synchronous rollback paths retain their smaller established caps.
# BOOKER_WORKER_TOKEN_LIMIT=6000
# Synchronous Backstage generation stage preference. Values parse through 45000ms, while
# ordinary execution is capped at 40000ms and HRC at 30000ms so recovery and finalization fit below 60000ms.
# BOOKER_GENERATION_STAGE_TIMEOUT_MS=40000
# Lightweight continuity generation stage budget, clamped to 1000-25000ms.
# BOOKER_CONTINUITY_STAGE_TIMEOUT_MS=20000
# Protected queued-generation deadline and worker stage budgets. The job deadline is clamped to
# 120000-180000ms; the primary stage to 45000-90000ms; recovery to 10000-45000ms. A 30000ms
# orchestration reserve and separate 10000ms result-persistence reserve are kept outside those stages;
# a 2000ms maximum cooperative abort drain fits inside the persistence reserve.
# BOOKER_WORKER_JOB_TIMEOUT_MS=180000
# BOOKER_WORKER_GENERATION_STAGE_TIMEOUT_MS=80000
# BOOKER_REPAIR_STAGE_TIMEOUT_MS=45000
# HRC reviewer model override. Defaults to the normal OpenAI model selection.
# HRC_MODEL=

# GPT route fast path
# Enables inline execution for small prompt-generation requests on POST /gpt/:gptId.
GPT_FAST_PATH_ENABLED=true
# Optional inline model override. Defaults to the lightweight repo fast-path model.
# GPT_FAST_PATH_MODEL=gpt-4.1-mini
# GPT_FAST_PATH_TIMEOUT_MS=8000
# GPT_FAST_PATH_MAX_PROMPT_CHARS=900
# GPT_FAST_PATH_MAX_MESSAGE_COUNT=3
# GPT_FAST_PATH_MAX_WORDS=350
# Optional comma-separated GPT IDs allowed to use the fast path. Empty means all GPT IDs.
# GPT_FAST_PATH_GPT_ALLOWLIST=arcanos-core,core
# Optional legacy bridge for small unadorned core queries. Leave false so the bounded
# request-mode core path can return inline unless the request explicitly asks for async work.
# GPT_ROUTE_ASYNC_CORE_DEFAULT=false
# Priority GPT async execution and queue lane.
# PRIORITY_GPT_IDS=arcanos-core,arcanos-audit,arcanos-build,arcanos-research,arcanos-write,arcanos-guide,arcanos-sim,arcanos-tracker,arcanos-tutor,arcanos-daemon,core,audit,build,research,write,guide,sim,tracker,tutor
PRIORITY_QUEUE_ENABLED=true
PRIORITY_QUEUE_WEIGHT=5
GPT_DIRECT_EXECUTION_THRESHOLD_MS=8000
GPT_WAIT_TIMEOUT_MS=24000
GPT_JOB_MAX_RETRIES=1
# GPT_PRIORITY_DIRECT_EXECUTION_CONCURRENCY=1

# Gaming / Web Guide Fetch
# Default timeout budget for ARCANOS:GAMING module dispatch.
# ARCANOS_GAMING_MODULE_TIMEOUT_MS=60000
# Per-guide snippet size used by gaming guide URL enrichment.
# ARCANOS_GAMING_WEB_CONTEXT_CHARS=5000
# Maximum user-provided guide URLs fetched concurrently for gaming enrichment.
# ARCANOS_GAMING_WEB_CONTEXT_MAX_URLS=15
# Gaming RAG retrieval for source-backed guide/build/meta answers.
# ARCANOS_GAMING_RAG_ENABLED=true
# ARCANOS_GAMING_RAG_MAX_SOURCES=4
# ARCANOS_GAMING_RAG_MAX_CHUNKS=6
# ARCANOS_GAMING_RAG_CHUNK_CHARS=900
# Shorter TTL for patch/meta-sensitive sources; longer TTL for stable guides.
# ARCANOS_GAMING_RAG_META_TTL_MS=900000
# ARCANOS_GAMING_RAG_GUIDE_TTL_MS=86400000
# Optional JSON array of curated sources. `game`/`games` scopes entries without requiring a built-in title registration; omit them for topic-scoped global sources.
# Example: [{"url":"https://example.com/guide","title":"Community guide","game":"Any Game Title","modes":["guide"],"topics":["boss"],"sourceType":"wiki","stable":true}]
# ARCANOS_GAMING_CURATED_SOURCES_JSON=
# Optional bounded open-web discovery. Disabled by default; missing provider credentials never block startup or supplied/curated RAG.
# ARCANOS_GAMING_DISCOVERY_ENABLED=false
# ARCANOS_GAMING_DISCOVERY_PROVIDER=brave
# ARCANOS_GAMING_DISCOVERY_SEARCH_RESULT_LIMIT=8
# ARCANOS_GAMING_DISCOVERY_FETCH_CANDIDATE_LIMIT=3
# ARCANOS_GAMING_DISCOVERY_TIMEOUT_MS=4000
# ARCANOS_GAMING_DISCOVERY_BUDGET_MS=7000
# Optional generic query-cache TTL override; defaults remain 2h for stable guides and 5m for meta/patch searches.
# ARCANOS_GAMING_DISCOVERY_QUERY_CACHE_TTL_MS=7200000
# ARCANOS_GAMING_DISCOVERY_GUIDE_CACHE_TTL_MS=7200000
# ARCANOS_GAMING_DISCOVERY_META_CACHE_TTL_MS=300000
# ARCANOS_GAMING_DISCOVERY_CACHE_MAX_ENTRIES=100
# ARCANOS_GAMING_DISCOVERY_MIN_CANDIDATE_SCORE=0.45
# ARCANOS_GAMING_DISCOVERY_MIN_EVIDENCE_QUALITY=0.45
# Optional comma-separated domain policy. An empty allowlist permits public domains not otherwise blocked.
# ARCANOS_GAMING_DISCOVERY_DOMAIN_ALLOWLIST=
# ARCANOS_GAMING_DISCOVERY_DOMAIN_BLOCKLIST=
# Optional verified official domains. Search-result text alone never grants official-source status.
# ARCANOS_GAMING_DISCOVERY_OFFICIAL_DOMAINS=
# ARCANOS_GAMING_DISCOVERY_MAX_PROVIDER_RESPONSE_BYTES=512000
# One aggregate Research deadline across DNS/fetch, Trinity/model, and persistence work.
# Missing, blank, nonnumeric, or sub-1 values use 60,000 ms; values above 300,000 ms are capped.
# Shorter request or caller deadlines still take precedence.
# RESEARCH_WORKFLOW_TIMEOUT_MS=60000
# Shared SSRF-safe web fetch limits.
# WEB_FETCH_TIMEOUT_MS=8000
# WEB_FETCH_MAX_BYTES=1500000
# WEB_FETCH_MAX_CHARS=12000
# WEB_FETCH_MAX_LINKS=15
# Redirects are intentionally disabled in code because they bypass IP pinning.
# WEB_FETCH_USER_AGENT=Arcanos-WebFetcher/1.0

# Feature flags
# ENABLE_ACTION_PLANS=false
# ENABLE_CLEAR_2=false
# Deprecated root/module AI routes. Leave enabled during migration to `/gpt/:gptId`,
# then set to `disabled` to remove `/arcanos`, `/write`, `/guide`, `/sim`,
# `/queryroute`, and `/modules/:moduleRoute`.
# LEGACY_GPT_ROUTES=enabled

# Self-heal loop
# Starts automatically on boot from src/server.ts and ticks every 30s by default.
# PREDICTIVE_HEALING_INTERVAL_MS=30000
# SELF_HEAL_LOOP_INTERVAL_MS=30000 # Alias for backward compatibility
# SELF_HEAL_DEBUG_FORCE_AI_HEAL_ONCE=false # Development/test-only one-shot validation override; ignored in production

# Self-heal privileged action approval.
# These are intentionally unset by default. Use only for tightly scoped operator
# recovery windows; read-only Railway inspection does not require them.
# SELF_HEAL_OPERATOR_ACTION_APPROVED=false
# SELF_HEAL_OPERATOR_ACTION_APPROVED_BY=
# SELF_HEAL_OPERATOR_ACTION_REASON=
# SELF_HEAL_OPERATOR_ACTION_NAME=
# SELF_HEAL_OPERATOR_ACTION_EXPIRES_AT=

# Predictive self-healing
# Keep dry-run on until you have audited decisions in /status/safety/self-heal
# and the control-plane-authenticated /api/self-heal/decide route.
# When enabled, predictive recommendation/dry-run/refusal owns the loop tick and
# cannot fall through to a separate reactive action or automatic controller.
# Explicitly disabling prediction preserves the legacy reactive policy gates.
# PREDICTIVE_HEALING_ENABLED=false
# PREDICTIVE_HEALING_DRY_RUN=true
# PREDICTIVE_DRY_RUN=true # Alias for backward compatibility
# PREDICTIVE_AUTO_EXECUTE=false
# AUTO_EXECUTE_HEALING=false # Alias for backward compatibility
# PREDICTIVE_HEALING_WINDOW_MS=300000
# PREDICTIVE_HEALING_MIN_OBSERVATIONS=3
# PREDICTIVE_HEALING_STALE_AFTER_MS=120000
# Alias: PREDICTIVE_AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.65
# PREDICTIVE_HEALING_MIN_CONFIDENCE=0.65
# PREDICTIVE_HEALING_COOLDOWN_MS=300000
# Alias: PREDICTIVE_HEALING_ACTION_COOLDOWN_MS=300000
# AI diagnosis backoff keeps the provider path from firing every loop tick.
# Idle/default recommendation: 6h. Live incident recommendation: 30m.
# PREDICTIVE_HEALING_AI_IDLE_COOLDOWN_MS=21600000
# PREDICTIVE_HEALING_AI_ACTIVE_COOLDOWN_MS=1800000
# PREDICTIVE_HEALING_AI_FAILURE_COOLDOWN_MS=21600000
# PREDICTIVE_HEALING_OBSERVATION_HISTORY_LIMIT=12
# PREDICTIVE_HEALING_AUDIT_HISTORY_LIMIT=25
# PREDICTIVE_ERROR_RATE_THRESHOLD=0.18
# PREDICTIVE_LATENCY_CONSECUTIVE_INTERVALS=3
# PREDICTIVE_LATENCY_RISE_DELTA_MS=350
# PREDICTIVE_MEMORY_THRESHOLD_MB=1024
# PREDICTIVE_MEMORY_GROWTH_THRESHOLD_MB=192
# PREDICTIVE_MEMORY_SUSTAINED_INTERVALS=3
# PREDICTIVE_QUEUE_PENDING_THRESHOLD=5
# PREDICTIVE_QUEUE_VELOCITY_THRESHOLD=2
# PREDICTIVE_SCALE_UP_STEP=1
# PREDICTIVE_SCALE_UP_MAX_EXTRA_WORKERS=2

# Token safety limits
# TOKEN_SAFE_MAX=8000

# Safety hardening controls
SAFETY_HEARTBEAT_TIMEOUT_MS=15000
SAFETY_HEARTBEAT_MISS_THRESHOLD=3
SAFETY_HEALTHY_CYCLES_TO_RECOVER=3
SAFETY_QUARANTINE_COOLDOWN_MS=120000
SAFETY_WORKER_RESTART_THRESHOLD=5
SAFETY_WORKER_RESTART_WINDOW_MS=300000
DISPATCH_V9_POLICY_TIMEOUT_MS=5000
SAFETY_FAIL_CLOSED_INTEGRITY=true

# Optional protected-configuration pins. These are lowercase SHA-256 digests of
# canonical semantic JSON, not raw file hashes. Build the exact candidate and
# use the normal integrity-gated startup path for every cutover while any
# runtime-owned pin is set. That already-built startup evaluation must report
# `preCutoverComplete: true`; it never updates a pin or trust-on-first-load
# state. Source-workspace commands build first, while pruned runtime images use
# only the already-built gate. The generic protected-JSON pin is tooling-only,
# requires an explicit manual source, and is not checked by automatic startup.
# See docs/CONFIGURATION.md.
# SAFETY_EXPECTED_HASH_DISPATCH_PATTERNS=
# SAFETY_EXPECTED_HASH_PROMPTS=
# SAFETY_EXPECTED_HASH_FALLBACK_MESSAGES=
# SAFETY_EXPECTED_HASH_GPT_ROUTER_CONFIG=
# SAFETY_EXPECTED_HASH_ASSISTANT_REGISTRY=
# SAFETY_EXPECTED_HASH_DAEMON_TOKENS=
# SAFETY_EXPECTED_HASH_PROTECTED_JSON=

# OpenAI server-side storage of requests/responses (default false)
OPENAI_STORE=false

# MCP HTTP transport. Required before POST /mcp will accept requests.
# MCP_BEARER_TOKEN=replace-with-a-strong-token
# Optional fixed requester identity for requester-owned ActionPlan tools over
# authenticated HTTP MCP. Requires MCP_BEARER_TOKEN and valid ActionPlan auth.
# ACTION_PLAN_MCP_REQUEST_PRINCIPAL_ID=replace-with-requester-principal-id
# MCP_ALLOWED_ORIGINS=
# Optional downward-only decoded JSON limit. The effective MCP limit is the
# strictest of this value, JSON_LIMIT, and the hard 1 MiB maximum. Invalid
# values fail startup, and 0 rejects every non-empty JSON entity.
# MCP_HTTP_BODY_LIMIT=1mb
# MCP_REQUIRE_CONFIRMATION=true
# MCP_CONFIRM_TTL_MS=60000
# MCP_EXPOSE_DESTRUCTIVE=false
# MCP_ENABLE_SESSIONS=false
# Also gates /gpt-access/capabilities/v1/:id/run; use final colon as module/action separator.
# Capability runs additionally require the GPT Access confirmation gate.
# MCP_ALLOW_MODULE_ACTIONS=ARCANOS:CORE:query

# Daemon tool continuation polling
DAEMON_RESULT_WAIT_MS=8000
DAEMON_RESULT_POLL_MS=250

# Admin observability
ADMIN_DB_PREVIEW_MAX_ROWS=100
ADMIN_DB_TABLE_LIST_LIMIT=40
# /metrics is enabled by default. Set token to require Authorization: Bearer
# or x-metrics-token; set METRICS_ENABLED=false to hide the endpoint.
# METRICS_AUTH_TOKEN=
# METRICS_ENABLED=true

# Web search agent
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_RATE_LIMIT_MAX=30
WEB_SEARCH_RATE_LIMIT_WINDOW_MS=600000
WEB_SEARCH_SNAPSHOT_CHARS=2000
TRAVERSE_LINKS_DEFAULT=false
WEB_SEARCH_TRAVERSAL_DEPTH=1
WEB_SEARCH_MAX_TRAVERSAL_PAGES=2
WEB_SEARCH_SAME_DOMAIN_ONLY=true
WEB_SEARCH_TRAVERSAL_LINK_LIMIT=3
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARXNG_BASE_URL=
